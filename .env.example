# Copy to .env.local for `pnpm dev`. Locally, saves go to the files in this folder.
ADMIN_PASSWORD=
# Optional locally (a random one is used if empty). Required on Netlify: 32+ random characters.
SESSION_SECRET=

# Netlify only (Project configuration → Environment variables):
# GITHUB_TOKEN=   fine-grained token, this repo only, Contents: read and write
# GITHUB_REPO=    optional, defaults to AimeexJB/AimeeRedmondPortfolioWebsite
# GITHUB_BRANCH=  optional, defaults to main
